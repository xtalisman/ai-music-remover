{
  "name": "ai-music-remover",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build && npm run copy-wasm",
    "preview": "vite preview",
    "test": "vitest run",
    "prebuild": "node scripts/prepare-lame.mjs && node scripts/generate-demos.mjs",
    "copy-wasm": "cp node_modules/onnxruntime-web/dist/ort-wasm-simd-threaded.wasm dist/assets/ && cp node_modules/onnxruntime-web/dist/ort-wasm-simd-threaded.jsep.wasm dist/assets/ && echo 'WASM copied'"
  },
  "dependencies": {
    "@xenova/transformers": "^2.17.2",
    "docx": "^9.10.0",
    "firebase": "^13.0.0",
    "jszip": "^3.10.2",
    "lamejs": "^1.2.1",
    "onnxruntime-web": "^1.20.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^6.26.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.0",
    "@tailwindcss/vite": "^4.1.0",
    "@types/react": "^18.3.3",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^4.3.1",
    "sirv-cli": "^3.0.1",
    "tailwindcss": "^4.1.0",
    "typescript": "^5.5.3",
    "vite": "^6.0.0",
    "vite-plugin-static-copy": "^4.1.1",
    "vitest": "^2.1.0"
  }
}
