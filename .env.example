# ============================================================
# Firebase Auth (free tier) — optional.
# Copy this file to `.env` and fill in the values from your
# Firebase project console: https://console.firebase.google.com
#   1. Create a project (free Spark plan is enough)
#   2. Add a Web app → copy the firebaseConfig values below
#   3. Enable sign-in methods: Email/Password and Google
#      (Authentication → Sign-in method)
#   4. Add your site domain under Authentication → Settings →
#      Authorized domains (e.g. ai-music-remover.vercel.app)
#
# If any key is missing, the app runs fully without sign-in:
# no auth gates, no modal — everything works as before.
# ============================================================

VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_APP_ID=
